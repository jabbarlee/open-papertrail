  "lines": [
    {
      "text": "Every Saturday, Otto buys one birthday candle.",
      "start": 0.12,
      "end": 2.8
    },
    {
      "text": "Just one.",
      "start": 3.22,
      "end": 3.7
    },
    {
      "text": "The baker has never asked who it's for.",
      "start": 4.62,
      "end": 6.7
    },
    {
      "text": "She just rings it up. Forty cents.",
      "start": 7,
      "end": 9.18
    },
    {
      "text": "Today, Otto asks for two.",
      "start": 9.58,
      "end": 11.56
    },
    {
      "text": "Whose birthday?",
      "start": 11.94,
      "end": 13.143,
      "speaker": "baker"
    },
    {
      "text": "Otto doesn't explain. He never does.",
      "start": 14.07,
      "end": 16.03
    },
    {
      "text": "At home, his cactus gets one candle every Saturday.",
      "start": 16.55,
      "end": 19.33
    },
    {
      "text": "This week, a small cactus grew out of the side.",
      "start": 19.99,
      "end": 22.29
    },
    {
      "text": "So it gets one too.",
      "start": 22.89,
      "end": 24.24
    }
  ],
